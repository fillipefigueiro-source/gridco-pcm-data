{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(python aprender_duracoes.py --dry-run)",
      "Bash(python -m http.server:*)",
