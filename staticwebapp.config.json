{
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/banco_dados.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/gestao_pcm.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/etiquetas.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/mpas.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/sugestoes.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/supervisores.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/confiabilidade.json",
      "allowedRoles": [
        "admin",
        "equipe"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  }
}